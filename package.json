{
  "name": "steel-warden",
  "version": "0.4.0",
  "private": true,
  "description": "STEEL WARDEN – Mech-Kampagnensimulator im Stil der Mitte-90er (Three.js + Vite), im Browser oder als Desktop-App",
  "author": "Rene",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MRFloyd84/steel-warden.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "steel-warden.desktop",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-credits": "node tools/check_credits.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node tools/check_credits.mjs && vite build",
    "app": "vite build && electron .",
    "dist:linux": "vite build && electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "three": "^0.187.0",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "de.rene.steelwarden",
    "productName": "STEEL WARDEN",
    "executableName": "steel-warden",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Mech-Kampagnensimulator",
      "artifactName": "STEEL_WARDEN-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "STEEL WARDEN",
          "Comment": "Walker-Kampagne gegen die Synthese"
        }
      },
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MRFloyd84",
        "repo": "steel-warden",
        "releaseType": "release"
      }
    ]
  }
}
